# ── OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── JWT ────────────────────────────────────────────────
SECRET_KEY=base64-hmac-sha512-key-min-64-chars-please-generate-one

# ── Gmail ──────────────────────────────────────────────
GMAIL_REDIRECT_URI=http://localhost:5173/gmail/callback
GMAIL_ENCRYPTION_KEY=aes-256-base64-key-32-bytes

# ── Database ───────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/joblelo_db
DB_USERNAME=root
DB_PASSWORD=your-password

# ── LLM ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_FALLBACK_API_KEY=gsk_your-fallback-groq-api-key
OPEN_ROUTER_API_KEY=sk-or-your-openrouter-key
GEMINI_API_KEY=your-gemini-api-key

# ── Job Portals ────────────────────────────────────────
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JOOBLE_API_KEY=your-jooble-api-key

# ── Config ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
REDIS_URL=redis://127.0.0.1:6379/0
